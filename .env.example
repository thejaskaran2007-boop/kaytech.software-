# Kaytech Construction Software — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to git — it contains secrets.

# Supabase PostgreSQL connection string
# Format: postgresql://postgres.[ref]:[password]@[host]:5432/postgres
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# API server port (default 3001)
PORT=3001

# Node environment
NODE_ENV=development
